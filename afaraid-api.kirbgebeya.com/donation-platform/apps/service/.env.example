NODE_ENV=development
PORT=5000

# Development
DB_NAME_DEV=myapp_dev
DB_USER_DEV=root
DB_PASSWORD_DEV=
DB_HOST_DEV=127.0.0.1
DB_PORT_DEV=3306

# Test
DB_NAME_TEST=myapp_test
DB_USER_TEST=root
DB_PASSWORD_TEST=password
DB_HOST_TEST=127.0.0.1
DB_PORT_TEST=3307


# Production
DB_NAME_PROD=myapp_prod
DB_USER_PROD=prod_user
DB_PASSWORD_PROD=securepass
DB_HOST_PROD=db.example.com
DB_PORT_PROD=3306

JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d


EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password

PAYMENT_PROVIDER_API_KEY=your_payment_api_key
